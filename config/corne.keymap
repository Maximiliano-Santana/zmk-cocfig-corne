#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // | ESC  |   Q   |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |   O   |    P    | BSPC  |
            // | TAB  |   A   |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |   L   |  MINUS  | EQUAL |
            // | SHFT |  CTRL |  Z  |  X  |  C  |  V  |   |  B  |  M   |  N  |   ,   |    .    | SHFT  |
            //                    | ALT | LWR | SPC |   | ENT | RSE  | GUI |

            bindings = <
&kp ESC    &kp Q      &kp W  &kp E         &kp R  &kp T        &kp Y    &kp U  &kp I              &kp O      &kp P      &kp BSPC
&kp TAB    &kp A      &kp S  &kp D         &kp F  &kp G        &kp H    &kp J  &kp K              &kp L      &kp MINUS  &kp QMARK
&kp LSHFT  &kp LCTRL  &kp Z  &kp X         &kp C  &kp V        &kp B    &kp N  &kp M              &kp COMMA  &kp DOT    &kp RSHFT
                             &kp LEFT_ALT  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RIGHT_COMMAND
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp N2     &kp N3      &kp N4             &kp N5            &kp N6      &kp N7       &kp KP_DIVIDE    &kp KP_N7  &kp KP_N8  &kp KP_N9        &kp KP_NUMLOCK  &kp BSPC
&kp N1     &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_VOL_UP      &kp C_NEXT  &kp N8       &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_NUMBER_6  &kp KP_PLUS     &kp KP_MINUS
&kp LSHFT  &trans      &trans             &kp K_PLAY_PAUSE  &kp N0      &kp N9       &kp CARET        &kp KP_N1  &kp KP_N2  &kp KP_N3        &kp KP_DOT      &kp RIGHT_SHIFT
                                          &kp LGUI          &trans      &kp SPACE    &kp RET          &trans     &kp KP_N0
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp PIPE   &kp AMPERSAND  &kp AT    &kp HASH  &kp DLLR          &kp PRCNT    &trans    &kp PG_UP  &kp UP    &trans     &kp DEL  &kp BSPC
&kp COLON  &kp LPAR       &kp RPAR  &kp LBRC  &kp RBRC          &kp SEMI     &kp HOME  &kp LEFT   &kp DOWN  &kp RIGHT  &kp END  &trans
&kp LSHFT  &trans         &kp LBKT  &kp RBKT  &kp SINGLE_QUOTE  &kp TILDE    &trans    &kp PG_DN  &trans    &trans     &trans   &trans
                                    &kp LGUI  &trans            &kp SPACE    &kp RET   &trans     &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&kp F2      &kp F3        &kp F4      &kp F5  &kp F6   &kp F7    &trans  &trans  &trans  &trans  &trans  &trans
&kp F1      &kp CAPSLOCK  &trans      &trans  &kp F11  &kp F8    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR  &bt BT_PRV    &bt BT_NXT  &trans  &kp F10  &kp F9    &trans  &trans  &trans  &trans  &trans  &trans
                                      &trans  &trans   &trans    &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        LayerThree {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
